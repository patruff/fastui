{
  "name": "voice-ui-builder",
  "version": "1.0.0",
  "description": "Voice-powered UI builder using OpenAI Realtime API and Codex",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
